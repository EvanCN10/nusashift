# Google Gemini API Key (used server-side by src/app/api/explain/route.ts for gemini-3.8-flash)
# If omitted or offline, NusaShift automatically falls back to deterministic physics-based narration.
GEMINI_API_KEY=your_gemini_api_key_here

# Public base URL for shared investigation links (optional in local development)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NASA Earthdata Login bearer token (optional, not read by any code yet; see docs_production/BACKEND_ITERATION_PROPOSAL.md P6)
# Server-only: never prefix with NEXT_PUBLIC_. Generate your own at https://urs.earthdata.nasa.gov
NASA_EARTHDATA=
